# ─────────────────────────────────────────────
# CodeVault — single Next.js full-stack app
#
# Copy to `.env` and fill in. Every variable here is SERVER-ONLY and is never
# exposed to the browser. Do not prefix any of these with NEXT_PUBLIC_.
# ─────────────────────────────────────────────

NODE_ENV=development

# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codevault"

# ─────────────────────────────────────────────
# Redis
# Used for Better Auth session storage (ba:*), API rate limiting (rl:*)
# and the document cache (doc:*).
# ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# Better Auth
# BETTER_AUTH_URL is the app's own origin — frontend and API share it now.
# Generate a secret with: openssl rand -base64 32
# ─────────────────────────────────────────────
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Trusted origins for Better Auth callbacks (comma-separated).
# No longer used for CORS — the API is same-origin.
CORS_ORIGIN="http://localhost:3000"

# ─────────────────────────────────────────────
# Razorpay (billing)
# Optional in development; billing routes return a configuration error
# rather than crashing when these are unset.
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_ID_TEAM=""
RAZORPAY_PLAN_ID_ENTERPRISE=""

# ─────────────────────────────────────────────
# Security
# Comma-separated IPs exempt from rate limiting.
# ─────────────────────────────────────────────
RATE_LIMIT_BYPASS_IPS=""
